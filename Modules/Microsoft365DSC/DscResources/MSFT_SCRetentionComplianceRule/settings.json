{
  "resourceName": "SCRetentionComplianceRule",
  "description": "This resource configures a Retention Compliance Rule in Purview.",
  "roles": {
    "read": [
      "Compliance Administrator"
    ],
    "update": [
      "Compliance Administrator"
    ]
  },
  "permissions": {
    "Office 365 Exchange Online": {
      "application": {
        "read": [
          {
            "name": "Exchange.ManageAsApp"
          }
        ],
        "update": [
          {
            "name": "Exchange.ManageAsApp"
          }
        ]
      }
    },
    "purview": {
      "requiredRoles": {
        "read": [
          "View-Only Retention Management"
        ],
        "update": [
          "Retention Management"
      ]
      },
      "requiredRoleGroups": {
        "read": [
          "Global Reader"
        ],
        "update": [
          "Records Management"
        ]
      }
    }
  },
  "requiredModules": [],
  "supportedEnvironments": [
    "Global",
    "USGov"
  ],
  "mode": "Configuration"
}
