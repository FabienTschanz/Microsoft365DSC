{
  "resourceName": "SCDeviceConfigurationPolicy",
  "description": "This resource configures a Device Configuration Policy in Purview.",
  "roles": {
    "read": [
      "Security Reader"
    ],
    "update": [
      "Compliance Administrator"
    ]
  },
  "permissions": {
    "Office 365 Exchange Online": {
      "application": {
        "read": [
          {
            "name": "Exchange.ManageAsApp"
          }
        ],
        "update": [
          {
            "name": "Exchange.ManageAsApp"
          }
        ]
      }
    },
    "purview": {
      "requiredRoles": {
        "read": [
          "View-Only Device Management"
        ],
        "update": [
          "Device Management"
        ]
      },
      "requiredRoleGroups": {
        "read": [
          "Security Reader"
        ],
        "update": [
          "Compliance Data Administrator"
        ]
      }
    }
  },
  "requiredModules": [],
  "supportedEnvironments": [
    "Global",
    "USGov"
  ],
  "mode": "Configuration"
}
