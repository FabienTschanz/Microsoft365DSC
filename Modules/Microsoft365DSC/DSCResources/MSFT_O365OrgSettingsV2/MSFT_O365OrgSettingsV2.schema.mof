    [Write, Description("Configuration for Microsoft 365 Lighthouse."), EmbeddedInstance("MSFT_Microsoft365Lighthouse")] string Microsoft365Lighthouse;
    [Write, Description("Configuration for Microsoft 365 on the web."), EmbeddedInstance("MSFT_Microsoft365OnTheWeb")] string Microsoft365OnTheWeb;
    [Write, Description("Configuration for Microsoft communication to users."), EmbeddedInstance("MSFT_Microsoft365EndUserCommunications")] string MicrosoftCommunicationToUsers;
    [Write, Description("Configuration for Microsoft Forms."), EmbeddedInstance("MSFT_Microsoft365Forms")] string MicrosoftForms;
    [Write, Description("Configuration for Microsoft Graph Data Connect."), EmbeddedInstance("MSFT_MicrosoftGraphDataConnect")] string MicrosoftGraphDataConnect;
    [Write, Description("Configuration for Microsoft Loop."), EmbeddedInstance("MSFT_Microsoft365Loop")] string MicrosoftLoop;
    [Write, Description("Configuration for Microsoft Planner."), EmbeddedInstance("MSFT_Microsoft365Planner")] string MicrosoftPlanner;
    [Write, Description("Configuration for Microsoft Teams."), EmbeddedInstance("MSFT_Microsoft365Teams")] string Microsoft365Teams;
    [Write, Description("Configuration for Microsoft Viva Insights."), EmbeddedInstance("MSFT_Microsoft365Viva")] string Microsoft365Viva;
    [Write, Description("Configuration for Microsoft 365 Modern Authentication."), EmbeddedInstance("MSFT_Microsoft365ModernAuth")] string Microsoft365ModernAuth;
    [Write, Description("Configuration for Microsoft 365 News."), EmbeddedInstance("MSFT_Microsoft365News")] string Microsoft365News;
    [Write, Description("Configuration for Microsoft 365 Reports."), EmbeddedInstance("MSFT_Microsoft365Reports")] string Microsoft365Reports;
    [Write, Description("Configuration for Microsoft 365 Usage Analytics."), EmbeddedInstance("MSFT_Microsoft365UsageAnalytics")] string Microsoft365UsageAnalytics;
    [Write, Description("Configuration for Microsoft Sway."), EmbeddedInstance("MSFT_Microsoft365Sway")] string MicrosoftSway;
    [Write, Description("Configuration for Microsoft 365 Apps and Services."), EmbeddedInstance("MSFT_Microsoft365AppsAndServices")] string Microsoft365AppsAndServices;
