    [Write, Description("Configuration for Microsoft Whiteboard."), EmbeddedInstance("MSFT_Microsoft365Whiteboard")] string Microsoft365Whiteboard;
    [Write, Description("Credentials of the Global Admin"), EmbeddedInstance("MSFT_Credential")] string Credential;
