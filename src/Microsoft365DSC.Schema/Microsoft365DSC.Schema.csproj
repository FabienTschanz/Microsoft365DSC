<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Microsoft365DSC.Schema</AssemblyName>
    <RootNamespace>Microsoft365DSC.Schema</RootNamespace>
    <IsPackable>true</IsPackable>
    <Description>The resource schema and DSC keyword cache of a built Microsoft365DSC module.</Description>

    <!-- Content only: there is no assembly, and a consumer that restores this needs no dependency
         of ours to read two JSON files. -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <M365DscModuleRoot>$(MSBuildThisFileDirectory)..\..\Modules\Microsoft365DSC</M365DscModuleRoot>

    <!-- The artifacts are keyed by the engine version that produced them, which is the module's and
         not this package's: a consumer resolves a schema by the version a tenant's pipeline ran. -->
    <M365DscModuleVersion Condition="'$(M365DscModuleVersion)' == '' AND Exists('$(M365DscModuleRoot)\Microsoft365DSC.psd1')">$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(M365DscModuleRoot)\Microsoft365DSC.psd1')), "ModuleVersion\s*=\s*'([^']+)'").Groups[1].Value)</M365DscModuleVersion>
  </PropertyGroup>

  <Target Name="AssertSchemaArtifactsExist" BeforeTargets="Pack">
    <Error Condition="'$(M365DscModuleVersion)' == ''"
           Text="The module version could not be read from Microsoft365DSC.psd1." />
    <Error Condition="!Exists('$(M365DscModuleRoot)\SchemaDefinition.json') OR !Exists('$(M365DscModuleRoot)\DscSchemaCache.json')"
           Text="SchemaDefinition.json and DscSchemaCache.json are build outputs of the module. Run Utilities/Build-Microsoft365DSC.ps1 before packing." />
  </Target>

  <ItemGroup>
    <None Include="$(M365DscModuleRoot)\SchemaDefinition.json" Pack="true" PackagePath="schema\$(M365DscModuleVersion)\" />
    <None Include="$(M365DscModuleRoot)\DscSchemaCache.json" Pack="true" PackagePath="schema\$(M365DscModuleVersion)\" />
    <None Include="build\Microsoft365DSC.Schema.targets" Pack="true" PackagePath="build\" />
  </ItemGroup>

</Project>
